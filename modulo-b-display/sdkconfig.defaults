# ============================================================================
# Módulo B — exibição (ESP32-S3 N16R8 + painel RGB 800x480)
# ============================================================================

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Tick de 1 ms: melhora a resolução do tick do LVGL e do timer de UI a 10 Hz
CONFIG_FREERTOS_HZ=1000

# --- Flash: N16R8 = 16 MB em QIO a 80 MHz ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM: 8 MB OCTAL a 80 MHz (os dois framebuffers do painel moram aqui) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Código e rodata executando da PSRAM liberam o cache da flash; sem isso,
# operações de flash (log, NVS) roubam banda do barramento e o painel RGB
# perde sincronismo (tela "rasga" ou desloca).
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# Alocações pequenas ficam na SRAM interna (DMA e structs de driver)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- Cache: máximo de banda para o varrimento contínuo do painel ---
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ISR do LCD RGB em IRAM: continua alimentando o painel mesmo durante
# operações de flash — par com o bounce buffer em SRAM (display_init.c)
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# --- Tabela de partições própria (app de 8 MB) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- LVGL 9 ---
CONFIG_LV_COLOR_DEPTH_16=y
# Memória dos widgets pelo malloc do sistema, não pelo pool fixo de 64 KB do
# LVGL: 5 telas do EEZ estourariam o pool. Com SPIRAM_MALLOC_ALWAYSINTERNAL
# acima, blocos pequenos ficam na SRAM e os grandes vão para a PSRAM.
CONFIG_LV_USE_CLIB_MALLOC=y
# Fontes Montserrat embutidas: TODOS os tamanhos pares de 8 a 48, porque o
# EEZ Studio oferece todos na lista de fontes e o código gerado quebra o
# build se usar um tamanho desabilitado aqui. Custa ~1 MB de flash (app tem 8).
# Depois de mexer aqui, apague o sdkconfig.modulo_b para ele ser refeito.
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_46=y
CONFIG_LV_FONT_MONTSERRAT_48=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
